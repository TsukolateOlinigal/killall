-- ============================================
-- FUNÇÃO PARA ATIVAR/DESATIVAR ORBIT
-- ============================================
local function alternarOrbit()
    -- SE JÁ ESTIVER ORBITANDO, DESLIGA
    if orbitando then
        orbitando = false
        if conexaoOrbit then
            conexaoOrbit:Disconnect()
            conexaoOrbit = nil
        end
        alvoFixo = nil
        angulo = 0
        statusLabel.Text = "🔴 Orbit: OFF"
        print("🌀 Orbit DESATIVADO")
        return
    end

    -- PEGA O PERSONAGEM DO JOGADOR
    local character = player.Character
    if not character then
        statusLabel.Text = "🔴 Sem personagem"
        print("❌ Personagem não encontrado!")
        return
    end

    -- PEGA O ROOT PART
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        statusLabel.Text = "🔴 Sem RootPart"
        print("❌ RootPart não encontrado!")
        return
    end

    -- PROCURA O PLAYER MAIS PRÓXIMO
    local closest = nil
    local closestDist = math.huge

    for _, p in pairs(game:GetService("Players"):GetPlayers()) do
        if p ~= player then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local targetRoot = char.HumanoidRootPart
                local dist = (rootPart.Position - targetRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = p
                end
            end
        end
    end

    if not closest then
        statusLabel.Text = "🔴 Nenhum player"
        print("❌ Nenhum player próximo!")
        return
    end

    -- FIXA O ALVO
    alvoFixo = closest
    orbitando = true
    angulo = 0
    statusLabel.Text = "🟢 Orbit: " .. alvoFixo.Name .. " (🔒)"
    print("🌀 Orbitando em: " .. alvoFixo.Name)

    -- LOOP DA ÓRBITA
    conexaoOrbit = game:GetService("RunService").Heartbeat:Connect(function()
        if not orbitando then
            if conexaoOrbit then
                conexaoOrbit:Disconnect()
                conexaoOrbit = nil
            end
            return
        end

        -- VERIFICA SE O ALVO AINDA EXISTE
        if not alvoFixo then
            statusLabel.Text = "🔴 Alvo perdido"
            orbitando = false
            return
        end

        local char = player.Character
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local targetChar = alvoFixo.Character
        
        -- 🔥 SE O ALVO MORREU OU SAIU, PARA A ÓRBITA
        if not targetChar then
            statusLabel.Text = "🔴 Alvo morreu!"
            print("💀 Alvo morreu! Parando órbita...")
            orbitando = false
            if conexaoOrbit then
                conexaoOrbit:Disconnect()
                conexaoOrbit = nil
            end
            alvoFixo = nil
            angulo = 0
            return
        end

        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        -- CALCULA A NOVA POSIÇÃO DA ÓRBITA
        angulo = angulo + velocidade * 0.1
        local x = targetRoot.Position.X + math.cos(angulo) * distancia
        local z = targetRoot.Position.Z + math.sin(angulo) * distancia
        local y = targetRoot.Position.Y

        -- APLICA A POSIÇÃO
        root.CFrame = CFrame.new(x, y, z)

        -- FAZ O PERSONAGEM OLHAR PARA O ALVO
        local direcao = (targetRoot.Position - root.Position).Unit
        root.CFrame = CFrame.lookAt(root.Position, root.Position + direcao)
    end)
end

