bolinha.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

-- ============================================
-- ARRASTE DA UI
-- ============================================

local dragging = false
local dragStart = nil
local startPos = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

titleBar.InputChanged:Connect(function(input)
    if not dragging then return end
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end)

titleBar.InputEnded:Connect(function()
    dragging = false
end)

-- ============================================
-- ARRASTE DA BOLINHA
-- ============================================

local draggingB = false
local dragStartB = nil
local startPosB = nil

bolinha.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingB = true
        dragStartB = input.Position
        startPosB = bolinha.Position
    end
end)

bolinha.InputChanged:Connect(function(input)
    if not draggingB then return end
    local delta = input.Position - dragStartB
    bolinha.Position = UDim2.new(
        startPosB.X.Scale, startPosB.X.Offset + delta.X,
        startPosB.Y.Scale, startPosB.Y.Offset + delta.Y
    )
end)

bolinha.InputEnded:Connect(function()
    draggingB = false
end)

